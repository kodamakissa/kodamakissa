---
import contato from '../data/contato.json';
---
<footer>
  <p class="kanji">木霊喫茶</p>
  <address>{contato.endereco}</address>
  <p>{contato.horarios}</p>
  <p><a href={`https://instagram.com/${contato.instagram}`}>@{contato.instagram}</a></p>
</footer>

<style>
  footer {
    padding: 2rem 1rem;
    border-top: 1px solid var(--borda);
    background: var(--fundo);
    font-size: 13px;
    line-height: 1.3;
    text-align: center;
  }

  p, address {
    margin: 0.25rem 0;
    font-style: normal;
  }

  .kanji {
    font-family: var(--fonte-kanji);
    font-size: 1.5rem;
  }

</style>
