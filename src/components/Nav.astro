---
const links = [
  { href: '/', label: 'Início' },
  { href: '/agenda', label: 'Agenda' },
  { href: '/blog', label: 'Blog' },
];

const atual = Astro.url.pathname.replace(/\/$/, '') || '/';
const ativo = (href) => (href === '/' ? atual === '/' : atual.startsWith(href));
---
<nav>
  <a href="/" class="marca">Kodama Kissa</a>
  <ul>
    {links.map(({ href, label }) => (
      <li><a href={href} aria-current={ativo(href) ? 'page' : undefined}>{label}</a></li>
    ))}
  </ul>
</nav>

<style>
  nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem;
    background: var(--musgo);
    color: var(--papel);
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  .marca {
    font-family: var(--fonte-letreiro);
    font-size: 1.25rem;
  }

  ul {
    display: flex;
    gap: 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  [aria-current='page'] {
    color: var(--broto);
    text-decoration: underline;
    text-underline-offset: 0.3em;
  }
</style>
