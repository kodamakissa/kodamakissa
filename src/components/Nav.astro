---
const links = [
  { href: '/', label: 'Início' },
  { href: '/agenda', label: 'Agenda' },
  { href: '/blog', label: 'Blog' },
];

const atual = Astro.url.pathname.replace(/\/$/, '') || '/';
const ativo = (href: string) => (href === '/' ? atual === '/' : atual.startsWith(href));
---
<nav>
  <a href="/" class="marca">
    <span class="hanko" aria-hidden="true">木霊</span>
    <span class="nome">Kodama Kissa</span>
    <span class="kanji" lang="ja"><ruby>木霊<rt>こだま</rt>喫茶<rt>きっさ</rt></ruby></span>
  </a>
  <ul>
    {links.map(({ href, label }) => (
      <li><a href={href} aria-current={ativo(href) ? 'page' : undefined}>{label}</a></li>
    ))}
  </ul>
</nav>

<style>
  nav {
    position: sticky;
    top: 0;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    padding: 0.6rem 1rem;
    background: var(--fundo);
    border-bottom: 1px solid var(--borda);
    box-shadow: 0 2px 6px rgb(0 0 0 / 0.08);
    font-size: 14px;
  }

  a {
    color: var(--texto);
    text-decoration: none;
  }

  a:hover {
    color: var(--link-hover);
  }

  .marca {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .hanko {
    display: inline-grid;
    place-items: center;
    width: 2.2em;
    height: 2.2em;
    border: 1.5px solid var(--laca);
    border-radius: 3px;
    color: var(--laca);
    font-family: var(--fonte-kanji);
    font-size: 12px;
    font-weight: 600;
    line-height: 1;
    writing-mode: vertical-rl;
  }

  .nome {
    font-size: 17px;
    font-weight: 700;
  }

  .kanji {
    color: var(--musgo);
    font-family: var(--fonte-kanji);
    font-feature-settings: "palt";
    letter-spacing: 0.1em;
  }

  rt {
    font-size: 0.55em;
    letter-spacing: 0;
  }

  ul {
    display: flex;
    gap: 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  [aria-current='page'] {
    color: var(--laca);
    text-decoration: underline;
    text-underline-offset: 0.3em;
  }
</style>
