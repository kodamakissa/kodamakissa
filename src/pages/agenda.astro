---
import Base from '../layouts/Base.astro';
import agenda from '../data/agenda.json';
---
<Base title="Agenda · Kodama Kissa">
  <article class="entry">
    <header class="entry-header">
      <h1 class="entry-title">Agenda<span class="rotulo" lang="ja">予定</span></h1>
    </header>
    <dl>
      {agenda.map((item) => (<><dt>{item.dia}</dt><dd>{item.atividade}</dd></>))}
    </dl>
  </article>
</Base>

<style>
  dt {
    margin-bottom: 5px;
    padding-bottom: 2px;
    border-bottom: 1px solid var(--borda);
    font-size: 16px;
    font-weight: 700;
  }

  dd {
    margin: 0 0 30px;
  }
</style>
